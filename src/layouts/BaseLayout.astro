---
import '../styles/global.css';
import { en } from '../data/i18n';

interface Props {
  title?: string;
  description?: string;
}

const { title = en.meta.title, description = en.meta.description } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og.png', Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />

    <!--
      Pre-paint lang sync: applies the resolved language to <html lang> before
      first paint. Default is Portuguese (DEFAULT_LANG in i18n/index.ts), so a
      first-time visitor with no stored choice opens in pt-BR; an explicit 'en'
      choice keeps English. Text content swaps happen in i18n-client.ts on load.
    -->
    <script is:inline>
      (function () {
        try {
          var v = localStorage.getItem('mywispy-lang');
          var lang = v === 'en' || v === 'pt' ? v : 'pt';
          if (lang === 'pt') document.documentElement.lang = 'pt-BR';
        } catch (_) {}
      })();
    </script>

    <title data-i18n="meta.title">{title}</title>
    <meta name="description" content={description} data-i18n="meta.description" data-i18n-attr="content" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} data-i18n="meta.title" data-i18n-attr="content" />
    <meta property="og:description" content={description} data-i18n="meta.description" data-i18n-attr="content" />
    <meta property="og:site_name" content="mywispy.com" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Luis Pazzanese — Computer Engineer · mywispy.com" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} data-i18n="meta.title" data-i18n-attr="content" />
    <meta name="twitter:description" content={description} data-i18n="meta.description" data-i18n-attr="content" />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon: tiny inline SVG with monospace 'w' to match the engineer vibe -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230a0a0a'/%3E%3Ctext x='50%25' y='50%25' dy='.35em' text-anchor='middle' fill='%237ee7c7' font-family='monospace' font-size='20' font-weight='500'%3Ew%3C/text%3E%3C/svg%3E"
    />

    <!-- Fonts: preconnect + non-blocking load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <slot />

    <script>
      // Reveal-on-scroll: toggle `.is-visible` on `.reveal` elements as they enter view.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
      );

      for (const el of document.querySelectorAll('.reveal')) {
        observer.observe(el);
      }
    </script>

    <!-- Language toggle client: persists choice, swaps text content, crossfades. -->
    <script>
      import '../scripts/i18n-client';
    </script>
  </body>
</html>
