---
import { en } from '../data/i18n';

const year = new Date().getFullYear();
---

<section id="contact" class="reveal" aria-labelledby="contact-heading">
  <div class="container">
    <h2 id="contact-heading" data-i18n="sections.contact">{en.sections.contact}</h2>

    <dl class="contact">
      <div>
        <dt data-i18n="contact.emailLabel">{en.contact.emailLabel}</dt>
        <dd><a href="mailto:luis@mywispy.com">luis@mywispy.com</a></dd>
      </div>
      <div>
        <dt data-i18n="contact.linkedinLabel">{en.contact.linkedinLabel}</dt>
        <dd>
          <a href="https://www.linkedin.com/in/luis-pazzanese/" target="_blank" rel="noopener noreferrer">
            linkedin.com/in/luis-pazzanese
          </a>
        </dd>
      </div>
      <div>
        <dt data-i18n="contact.githubLabel">{en.contact.githubLabel}</dt>
        <dd>
          <a href="https://github.com/LuisPazzanese" target="_blank" rel="noopener noreferrer">
            github.com/LuisPazzanese
          </a>
        </dd>
      </div>
      <div>
        <dt data-i18n="contact.locationLabel">{en.contact.locationLabel}</dt>
        <dd data-i18n="contact.locationValue">{en.contact.locationValue}</dd>
      </div>
    </dl>

    <footer class="footer">
      <span>© {year} Luis Pazzanese</span>
      <span class="footer__sep" aria-hidden="true">·</span>
      <span data-i18n="contact.footer">{en.contact.footer}</span>
    </footer>
  </div>
</section>

<style>
  .contact {
    margin: 2rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .contact > div {
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }

  .contact dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.4rem;
  }

  .contact dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-dim);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer__sep {
    color: var(--line-strong);
  }
</style>
