---
import { en } from '../data/i18n';
---

<section id="about" class="reveal" aria-labelledby="about-heading">
  <div class="container">
    <h2 id="about-heading" data-i18n="sections.about">{en.sections.about}</h2>

    <article class="about">
      <p data-i18n-html="about.body" set:html={en.about.body}></p>

      <p class="about__intl" data-i18n="about.intl">{en.about.intl}</p>
    </article>
  </div>
</section>

<style>
  .about {
    margin-top: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    display: grid;
    gap: 1.25rem;
  }

  .about__intl {
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
</style>
