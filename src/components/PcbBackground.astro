---
// Three.js PCB-trace background for the hero.
// - Renders a sparse grid of nodes connected by orthogonal "traces"
// - Subtle drift + a single highlighted packet travelling along random traces
// - Falls back gracefully if WebGL is unavailable (canvas just stays empty)
// - Lazy: only initializes when the hero is in view; pauses when off-screen
---

<div class="pcb" aria-hidden="true">
  <canvas id="pcb-canvas"></canvas>
</div>

<style>
  .pcb {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Fade edges so the canvas blends into the page */
    mask-image: radial-gradient(ellipse at center, #000 55%, transparent 95%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 55%, transparent 95%);
  }

  #pcb-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('pcb-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    // Defer init until canvas is on screen; bail entirely if WebGL is missing.
    const init = () => {
      let renderer: THREE.WebGLRenderer;
      try {
        renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
          powerPreference: 'low-power',
        });
      } catch {
        return; // No WebGL — leave canvas empty.
      }
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setClearColor(0x000000, 0);

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 100);
      camera.position.set(0, 0, 14);

      // --- Build the PCB-like network ---
      // A grid of nodes; we pick a subset, then connect nearby pairs with L-shaped traces.
      const gridX = 14;
      const gridY = 8;
      const spacing = 1.6;
      const nodes: THREE.Vector3[] = [];
      for (let i = 0; i < gridX; i++) {
        for (let j = 0; j < gridY; j++) {
          if (Math.random() > 0.45) continue;
          const x = (i - (gridX - 1) / 2) * spacing + (Math.random() - 0.5) * 0.1;
          const y = (j - (gridY - 1) / 2) * spacing + (Math.random() - 0.5) * 0.1;
          nodes.push(new THREE.Vector3(x, y, 0));
        }
      }

      // Build orthogonal traces (L-shaped) between nearby nodes.
      const tracePoints: THREE.Vector3[] = [];
      const traceSegments: Array<[THREE.Vector3, THREE.Vector3, THREE.Vector3]> = [];
      for (const a of nodes) {
        // Connect each node to at most one nearby neighbor (cheap proximity check)
        const candidates = nodes
          .filter((b) => b !== a)
          .map((b) => ({ b, d: a.distanceTo(b) }))
          .filter((p) => p.d < spacing * 2.5)
          .sort((p, q) => p.d - q.d)
          .slice(0, 2);
        for (const { b } of candidates) {
          // L-shape: a -> corner -> b. Randomize axis order.
          const corner = Math.random() > 0.5
            ? new THREE.Vector3(b.x, a.y, 0)
            : new THREE.Vector3(a.x, b.y, 0);
          tracePoints.push(a, corner, corner, b);
          traceSegments.push([a.clone(), corner.clone(), b.clone()]);
        }
      }

      // Trace lines (dim, static)
      const traceGeo = new THREE.BufferGeometry().setFromPoints(tracePoints);
      const traceMat = new THREE.LineBasicMaterial({
        color: 0x2a5d4f,
        transparent: true,
        opacity: 0.55,
      });
      const traces = new THREE.LineSegments(traceGeo, traceMat);
      scene.add(traces);

      // Node dots
      const dotGeo = new THREE.BufferGeometry().setFromPoints(nodes);
      const dotMat = new THREE.PointsMaterial({
        color: 0x7ee7c7,
        size: 0.06,
        transparent: true,
        opacity: 0.9,
      });
      const dots = new THREE.Points(dotGeo, dotMat);
      scene.add(dots);

      // Packet: a bright point that travels one trace segment at a time.
      const packetGeo = new THREE.BufferGeometry();
      packetGeo.setAttribute(
        'position',
        new THREE.Float32BufferAttribute([0, 0, 0], 3),
      );
      const packetMat = new THREE.PointsMaterial({
        color: 0xffffff,
        size: 0.18,
        transparent: true,
        opacity: 1,
      });
      const packet = new THREE.Points(packetGeo, packetMat);
      scene.add(packet);

      let currentSeg = traceSegments[Math.floor(Math.random() * traceSegments.length)];
      let segT = 0; // 0..2 (two legs of the L)
      const segSpeed = 0.012;

      // --- Sizing + resize handling ---
      const resize = () => {
        const w = canvas.clientWidth || 1;
        const h = canvas.clientHeight || 1;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      };
      resize();
      const ro = new ResizeObserver(resize);
      ro.observe(canvas);

      // --- Animation ---
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let running = true;
      let raf = 0;

      const tick = () => {
        if (!running) return;
        // Slow drift
        const t = performance.now() * 0.00005;
        scene.rotation.z = Math.sin(t) * 0.05;
        camera.position.x = Math.sin(t * 1.3) * 0.6;
        camera.position.y = Math.cos(t * 1.1) * 0.4;
        camera.lookAt(0, 0, 0);

        // Advance packet
        if (traceSegments.length > 0 && currentSeg) {
          segT += segSpeed;
          let pos: THREE.Vector3;
          if (segT < 1) {
            pos = currentSeg[0].clone().lerp(currentSeg[1], segT);
          } else if (segT < 2) {
            pos = currentSeg[1].clone().lerp(currentSeg[2], segT - 1);
          } else {
            currentSeg = traceSegments[Math.floor(Math.random() * traceSegments.length)];
            segT = 0;
            pos = currentSeg[0].clone();
          }
          const attr = packetGeo.getAttribute('position') as THREE.BufferAttribute;
          attr.setXYZ(0, pos.x, pos.y, pos.z);
          attr.needsUpdate = true;
        }

        renderer.render(scene, camera);
        raf = requestAnimationFrame(tick);
      };

      if (reduced) {
        // Single render, no animation
        renderer.render(scene, camera);
      } else {
        raf = requestAnimationFrame(tick);
      }

      // Pause when tab hidden to save battery
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          running = false;
          cancelAnimationFrame(raf);
        } else if (!reduced) {
          running = true;
          raf = requestAnimationFrame(tick);
        }
      });
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            init();
          }
        },
        { rootMargin: '100px' },
      );
      io.observe(canvas);
    } else {
      init();
    }
  }
</script>
