---
import { en } from '../data/i18n';
---

<section id="experience" class="reveal" aria-labelledby="experience-heading">
  <div class="container">
    <h2 id="experience-heading" data-i18n="sections.experience">{en.sections.experience}</h2>

    <article class="job">
      <header class="job__head">
        <h3 class="job__role" data-i18n="experience.role">{en.experience.role}</h3>
        <span class="job__org">Zagros Capital Asset Management</span>
        <span class="job__when" data-i18n="experience.when">{en.experience.when}</span>
      </header>

      <p class="job__about" data-i18n="experience.about">{en.experience.about}</p>

      <ul class="job__bullets">
        {en.experience.bullets.map((b, i) => <li data-i18n={`experience.bullets.${i}`}>{b}</li>)}
      </ul>
    </article>
  </div>
</section>

<style>
  .job {
    margin-top: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }

  .job__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.75rem;
  }

  .job__role {
    font-size: 1.05rem;
    color: var(--fg);
  }

  .job__org {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--accent);
  }

  .job__when {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-dim);
    margin-left: auto;
  }

  .job__about {
    color: var(--fg-muted);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .job__bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .job__bullets li {
    padding-left: 1.25rem;
    position: relative;
    font-size: 0.95rem;
  }

  .job__bullets li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--accent-dim);
    font-family: var(--font-mono);
  }

  @media (max-width: 600px) {
    .job__when {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
