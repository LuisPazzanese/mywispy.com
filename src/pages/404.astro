---
import BaseLayout from '../layouts/BaseLayout.astro';
import LangToggle from '../components/LangToggle.astro';
import { en } from '../data/i18n';
---

<BaseLayout title="404 — page not found" description="Route not found.">
  <LangToggle />

  <main class="nf">
    <div class="container nf__inner">
      <pre class="nf__code" aria-label="Compiler error output"><span class="nf__prompt">$</span> <span class="nf__cmd">make serve</span>

src/router.ts: In function <span class="nf__sym">'resolveRoute'</span>:
src/router.ts:42:18: <span class="nf__error">error:</span> route <span class="nf__sym">'<span id="nf-path">/unknown-route</span>'</span> undeclared (first use in this function)
   42 |   return routes[<span class="nf__sym">'<span class="nf-path-mirror">/unknown-route</span>'</span>];
      |                  <span class="nf__caret">^~~~~~~~~~~~~~~~</span>
src/router.ts:42:18: <span class="nf__note">note:</span> each undeclared identifier is reported only once
src/router.ts:42:18: <span class="nf__error">error:</span> HTTP <span class="nf__title" data-i18n="notFound.title">{en.notFound.title}</span> Not Found
make: *** [serve] Error 404

<span class="nf__hash"># <span data-i18n="notFound.note">{en.notFound.note}</span></span>
<span class="nf__prompt">$</span> <a class="nf__cd" href="/" aria-label={en.notFound.backHomeAria} data-i18n-aria="notFound.backHomeAria">cd ~<span class="nf__cd-hint">  <span class="nf__hash" data-i18n="notFound.backHome"># {en.notFound.backHome}</span></span></a><span class="nf__caret-blink" aria-hidden="true">_</span></pre>
    </div>
  </main>
</BaseLayout>

<script>
  // Inject the actual requested path into the error message. The static 404.html
  // is served by Cloudflare Pages for any unmatched route, so window.location
  // reflects what the visitor typed.
  const path = window.location.pathname;
  const safe = path.replace(/[<>"'&]/g, (c) =>
    ({ '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;', '&': '&amp;' })[c]!,
  );
  const target = document.getElementById('nf-path');
  if (target) target.textContent = path;
  for (const m of document.querySelectorAll<HTMLElement>('.nf-path-mirror')) {
    m.textContent = path;
  }
  // Resize caret underline to match path length, capped so it doesn't overflow
  const caret = document.querySelector<HTMLElement>('.nf__caret');
  if (caret) {
    const n = Math.max(4, Math.min(48, path.length));
    caret.textContent = '^' + '~'.repeat(n - 1);
  }
  // Use `safe` so the linter doesn't complain about unused vars; intentionally
  // unused otherwise — textContent already escapes everything.
  void safe;
</script>

<style>
  .nf {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 5rem 0;
  }

  .nf__inner {
    width: 100%;
  }

  .nf__code {
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 1.6vw, 0.95rem);
    line-height: 1.55;
    color: var(--fg-muted);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.75rem;
    overflow-x: auto;
    white-space: pre;
    margin: 0;
  }

  .nf__prompt {
    color: var(--accent);
  }

  .nf__cmd {
    color: var(--fg);
  }

  .nf__error {
    color: #ff6b6b;
    font-weight: 500;
  }

  .nf__note {
    color: var(--accent);
    font-weight: 500;
  }

  .nf__sym {
    color: var(--fg);
  }

  .nf__caret {
    color: #ff6b6b;
  }

  .nf__title {
    color: var(--fg);
    font-weight: 500;
  }

  .nf__hash {
    color: var(--fg-dim);
  }

  .nf__cd {
    color: var(--accent);
    border-bottom: 1px solid transparent;
    text-decoration: none;
    transition: border-color 120ms var(--ease);
  }

  .nf__cd:hover,
  .nf__cd:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .nf__cd-hint {
    color: var(--fg-dim);
  }

  .nf__caret-blink {
    display: inline-block;
    margin-left: 4px;
    color: var(--accent);
    animation: nf-blink 1.1s steps(1) infinite;
  }

  @keyframes nf-blink {
    50% {
      opacity: 0;
    }
  }
</style>
